# Optional: point the dashboard at a separate Playwright worker.
# Leave unset for local execution (Playwright runs in-process).
WORKER_URL=
WORKER_TOKEN=<redacted>
# Demo app port
DEMO_PORT=4001
# Worker port
WORKER_PORT=4002
# Server-side gate for localhost / private targets. Default off.
# A client request (allowLocalTargets in the form/API) is IGNORED unless
# this is 'true'. Set to 'true' only for controlled local testing.
# On the deployed (public) dashboard this must stay unset/false.
ALLOW_LOCAL_TARGETS=
# Same gate for the standalone worker process.
WORKER_ALLOW_LOCAL_TARGETS=
# Persistent history storage (Upstash Redis via Vercel Marketplace —
# Vercel KV was sunset in Dec 2024, new stores are Upstash Redis).
# When a Redis database is linked, Vercel auto-injects the REST vars —
# the exact names depend on the prefix chosen at link time. With the
# UPSTASH_REDIS prefix the injected names are
# UPSTASH_REDIS_KV_REST_API_URL / UPSTASH_REDIS_KV_REST_API_TOKEN.
# Other integrations inject UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# Older Vercel KV credentials (KV_REST_API_URL / KV_REST_API_TOKEN) also
# work as a fallback. When unset, history falls back to a local JSON file
# (data/runs.json), which does not persist on Vercel serverless.
# Do NOT use UPSTASH_REDIS_KV_URL / UPSTASH_REDIS_REDIS_URL here — those
# are redis:// URLs, not the REST endpoint. Do not paste real values here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_KV_REST_API_URL=
UPSTASH_REDIS_KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=<redacted>
